# meetme .htaccess

# Set default index
DirectoryIndex index.php

# Prevent directory listing
Options -Indexes

# Protect sensitive directories and files
RewriteEngine On

# Deny direct access to data folders and sensitive PHP files
RewriteRule ^(cache|bookings|invites|vendor|lib\.php|config\.php|lang\.php)($|/) - [F,L]

# Clean URL for admin and feed
RewriteRule ^admin$ admin.php [L,QSA]
RewriteRule ^feed$ feed.php [L,QSA]
RewriteRule ^cancel$ cancel.php [L,QSA]

# Security Headers
<IfModule mod_headers.c>
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none';"
    Header set X-Frame-Options "DENY"
    Header set X-Content-Type-Options "nosniff"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
